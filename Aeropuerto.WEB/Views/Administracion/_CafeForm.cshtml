@model Cafeteria.WEB.Models.CafeAdminViewModel
<form asp-action="@(Model.Id == 0 ? "CrearCafe" : "EditarCafe")" method="post" style="max-width:650px">
	<div asp-validation-summary="ModelOnly"></div>
	<input asp-for="Id" type="hidden" />
	<label asp-for="Nombre"></label><input asp-for="Nombre" /><span asp-validation-for="Nombre"></span>
	<label asp-for="Descripcion"></label><textarea asp-for="Descripcion"></textarea>
	<label asp-for="Precio"></label><input asp-for="Precio" type="number" step="0.01" /><span asp-validation-for="Precio"></span>
	<label><input asp-for="Disponible" /> Disponible para el menú</label>
	<button type="submit">Guardar</button>
	<a asp-action="Index">Cancelar</a>
</form>
